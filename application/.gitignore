# ---------------------------------------------------------------- dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# ------------------------------------------------------------------- next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# ---------------------------------------------------------------------- data
# data/ is committed in full and deliberately NOT ignored -- the PDFs, the
# sanitized answer key, the pdftotext cache and the run history all travel with
# the repo, so a fresh clone can grade a run without regenerating anything.
#
# data/evidence/ holds two kinds of generated file, and they are treated
# differently on purpose:
#
#   *.png        rendered page images. Committed, so a fresh clone displays the
#                evidence for the committed runs without needing poppler
#                installed -- rendering is the one step a clone cannot redo on
#                a host that has no pdftoppm.
#
#   *.bbox.xhtml per-page word-geometry dumps. Ignored: they are consulted only
#                while capturing evidence, never to display it, so shipping them
#                would add weight the UI never reads. They are also a pure
#                cache -- deleting one just means the next scan re-derives it.
/data/evidence/*.bbox.xhtml

# ------------------------------------------------------------------- env files
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# ----------------------------------------------------------------------- misc
/coverage
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.pem
.vercel
.idea/
.vscode/*
!.vscode/extensions.json
